[174.987, "o", "\u001b[90m┌─ main.py · manejo de SIGINT ──────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[174.987, "o", "\u001b[90m  58\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_signal_handler\u001b[39;49;00m(sig: \u001b[96mint\u001b[39;49;00m, frame) -> \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[175.042, "o", "\u001b[90m  59\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33mManejador de señal SIGINT para permitir Ctrl+C limpio.\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[175.097, "o", "\u001b[90m  60\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[175.152, "o", "\u001b[90m  61\u001b[0m\u001b[90m │ \u001b[0m    Primer Ctrl+C: establece flag de cancelación para operaciones en curso.\u001b[90m\u001b[39;49;00m\n"]
[175.207, "o", "\u001b[90m  62\u001b[0m\u001b[90m │ \u001b[0m    Segundo Ctrl+C: sale \u001b[94mdel\u001b[39;49;00m programa inmediatamente.\u001b[90m\u001b[39;49;00m\n"]
[175.262, "o", "\u001b[90m  63\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
