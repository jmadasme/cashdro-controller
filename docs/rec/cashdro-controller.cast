[58.231, "o", "\u001b[90m┌─ cashdro_api.py · GET y reintentos ───────────────────────────────────────────────────────────────────\u001b[0m\n"]
[58.231, "o", "\u001b[90m 121\u001b[0m\u001b[90m │ \u001b[0m        last_exception: Optional[\u001b[96mException\u001b[39;49;00m] = \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[58.286, "o", "\u001b[90m 122\u001b[0m\u001b[90m │ \u001b[0m        last_cashdro_error: Optional[CashDroError] = \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[58.341, "o", "\u001b[90m 123\u001b[0m\u001b[90m │ \u001b[0m        system_busy_retries_left = MAX_RETRIES_SYSTEM_BUSY\u001b[90m\u001b[39;49;00m\n"]
[58.396, "o", "\u001b[90m 124\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[58.451, "o", "\u001b[90m 125\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mfor\u001b[39;49;00m attempt \u001b[95min\u001b[39;49;00m \u001b[96mrange\u001b[39;49;00m(\u001b[94m1\u001b[39;49;00m, \u001b[96mself\u001b[39;49;00m.max_retries + \u001b[94m1\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\n"]
[58.506, "o", "\u001b[90m 126\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[58.561, "o", "\u001b[90m 127\u001b[0m\u001b[90m │ \u001b[0m                response = requests.get(\u001b[90m\u001b[39;49;00m\n"]
[58.616, "o", "\u001b[90m 128\u001b[0m\u001b[90m │ \u001b[0m                    \u001b[96mself\u001b[39;49;00m.base_url,\u001b[90m\u001b[39;49;00m\n"]
[58.671, "o", "\u001b[90m 129\u001b[0m\u001b[90m │ \u001b[0m                    params=query_params,\u001b[90m\u001b[39;49;00m\n"]
[58.726, "o", "\u001b[90m 130\u001b[0m\u001b[90m │ \u001b[0m                    timeout=\u001b[96mself\u001b[39;49;00m.timeout,\u001b[90m\u001b[39;49;00m\n"]
[58.781, "o", "\u001b[90m 131\u001b[0m\u001b[90m │ \u001b[0m                    verify=\u001b[94mFalse\u001b[39;49;00m,  \u001b[90m# SSL autofirmado → deshabilitamos verificación\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[58.836, "o", "\u001b[90m 132\u001b[0m\u001b[90m │ \u001b[0m                )\u001b[90m\u001b[39;49;00m\n"]
[58.891, "o", "\u001b[90m 133\u001b[0m\u001b[90m │ \u001b[0m                response.raise_for_status()\u001b[90m\u001b[39;49;00m\n"]
[58.946, "o", "\u001b[90m 134\u001b[0m\u001b[90m │ \u001b[0m                data: \u001b[96mdict\u001b[39;49;00m[\u001b[96mstr\u001b[39;49;00m, Any] = response.json()\u001b[90m\u001b[39;49;00m\n"]
[59.001, "o", "\u001b[90m 135\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[59.056, "o", "\u001b[90m 136\u001b[0m\u001b[90m │ \u001b[0m                \u001b[90m# Verificar código de respuesta\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[59.111, "o", "\u001b[90m 137\u001b[0m\u001b[90m │ \u001b[0m                code = data.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mcode\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, -\u001b[94m99\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[59.166, "o", "\u001b[90m 138\u001b[0m\u001b[90m │ \u001b[0m                \u001b[94mif\u001b[39;49;00m code != \u001b[94m1\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[59.221, "o", "\u001b[90m 139\u001b[0m\u001b[90m │ \u001b[0m                    error_msg = \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[59.276, "o", "\u001b[90m 140\u001b[0m\u001b[90m │ \u001b[0m                    \u001b[94mif\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33mresponse\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m data \u001b[95mand\u001b[39;49;00m \u001b[96misinstance\u001b[39;49;00m(data[\u001b[33m\"\u001b[39;49;00m\u001b[33mresponse\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m], \u001b[96mdict\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\n"]
[59.331, "o", "\u001b[90m 141\u001b[0m\u001b[90m │ \u001b[0m                        error_msg = data[\u001b[33m\"\u001b[39;49;00m\u001b[33mresponse\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m].get(\u001b[33m\"\u001b[39;49;00m\u001b[33merrorMessage\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[59.386, "o", "\u001b[90m 142\u001b[0m\u001b[90m │ \u001b[0m                    \u001b[90m# Código -1900: System busy → reintentar automáticamente\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[59.441, "o", "\u001b[90m 143\u001b[0m\u001b[90m │ \u001b[0m                    \u001b[94mif\u001b[39;49;00m code == -\u001b[94m1900\u001b[39;49;00m \u001b[95mand\u001b[39;49;00m system_busy_retries_left > \u001b[94m0\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[59.496, "o", "\u001b[90m 144\u001b[0m\u001b[90m │ \u001b[0m                        system_busy_retries_left -= \u001b[94m1\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[59.551, "o", "\u001b[90m 145\u001b[0m\u001b[90m │ \u001b[0m                        time.sleep(RETRY_DELAY_SYSTEM_BUSY)\u001b[90m\u001b[39;49;00m\n"]
