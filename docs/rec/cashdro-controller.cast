[42.45, "o", "\u001b[90m┌─ config.py · timeouts y códigos ──────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[42.45, "o", "\u001b[90m  16\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# ─── Timeouts ────────────────────────────────────────────────────────\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.505, "o", "\u001b[90m  17\u001b[0m\u001b[90m │ \u001b[0mREQUEST_TIMEOUT: \u001b[96mint\u001b[39;49;00m = \u001b[94m10\u001b[39;49;00m       \u001b[90m# segundos — timeout por llamada HTTP\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.56, "o", "\u001b[90m  18\u001b[0m\u001b[90m │ \u001b[0mMAX_RETRIES: \u001b[96mint\u001b[39;49;00m = \u001b[94m3\u001b[39;49;00m            \u001b[90m# reintentos ante fallo de conexión\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.615, "o", "\u001b[90m  19\u001b[0m\u001b[90m │ \u001b[0mMAX_RETRIES_SYSTEM_BUSY: \u001b[96mint\u001b[39;49;00m = \u001b[94m3\u001b[39;49;00m   \u001b[90m# reintentos extra para código -1900 (System busy)\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.67, "o", "\u001b[90m  20\u001b[0m\u001b[90m │ \u001b[0mRETRY_DELAY_SYSTEM_BUSY: \u001b[96mint\u001b[39;49;00m = \u001b[94m5\u001b[39;49;00m   \u001b[90m# segundos de espera entre reintentos por System busy\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.725, "o", "\u001b[90m  21\u001b[0m\u001b[90m │ \u001b[0mPOLL_INTERVAL: \u001b[96mint\u001b[39;49;00m = \u001b[94m2\u001b[39;49;00m          \u001b[90m# segundos entre consultas de estado\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.78, "o", "\u001b[90m  22\u001b[0m\u001b[90m │ \u001b[0mPOLL_TIMEOUT: \u001b[96mint\u001b[39;49;00m = \u001b[94m120\u001b[39;49;00m         \u001b[90m# timeout total de polling (2 minutos)\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.835, "o", "\u001b[90m  23\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[42.89, "o", "\u001b[90m  24\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# ─── Códigos de error CashDro ───────────────────────────────────────\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.945, "o", "\u001b[90m  25\u001b[0m\u001b[90m │ \u001b[0mERROR_CODES: \u001b[96mdict\u001b[39;49;00m[\u001b[96mint\u001b[39;49;00m, \u001b[96mstr\u001b[39;49;00m] = {\u001b[90m\u001b[39;49;00m\n"]
[43.0, "o", "\u001b[90m  26\u001b[0m\u001b[90m │ \u001b[0m    -\u001b[94m1\u001b[39;49;00m:    \u001b[33m\"\u001b[39;49;00m\u001b[33mAuthentication Failed — usuario o contraseña incorrectos\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[43.055, "o", "\u001b[90m  27\u001b[0m\u001b[90m │ \u001b[0m    -\u001b[94m2\u001b[39;49;00m:    \u001b[33m\"\u001b[39;49;00m\u001b[33mOperation not queued / not found\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[43.11, "o", "\u001b[90m  28\u001b[0m\u001b[90m │ \u001b[0m    -\u001b[94m3\u001b[39;49;00m:    \u001b[33m\"\u001b[39;49;00m\u001b[33mWrong amount / Invalid parameters — monto inválido\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[43.165, "o", "\u001b[90m  29\u001b[0m\u001b[90m │ \u001b[0m    -\u001b[94m4\u001b[39;49;00m:    \u001b[33m\"\u001b[39;49;00m\u001b[33mUser does not have permission — usuario sin permisos\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[43.22, "o", "\u001b[90m  30\u001b[0m\u001b[90m │ \u001b[0m    -\u001b[94m99\u001b[39;49;00m:   \u001b[33m\"\u001b[39;49;00m\u001b[33mInvalid Parameters\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[43.275, "o", "\u001b[90m  31\u001b[0m\u001b[90m │ \u001b[0m    -\u001b[94m1900\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mSystem busy — sistema ocupado, reintente más tarde\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
