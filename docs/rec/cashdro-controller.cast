[175.372, "o", "\u001b[90m  65\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m _cancel_requested:\u001b[90m\u001b[39;49;00m\n"]
