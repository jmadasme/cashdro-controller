[108.292, "o", "\u001b[90m┌─ cashdro_api.py · wait_for_completion ────────────────────────────────────────────────────────────────\u001b[0m\n"]
[108.292, "o", "\u001b[90m 344\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mwait_for_completion\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\n"]
[108.347, "o", "\u001b[90m 345\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mself\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[108.402, "o", "\u001b[90m 346\u001b[0m\u001b[90m │ \u001b[0m        operation_id: \u001b[96mstr\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[108.457, "o", "\u001b[90m 347\u001b[0m\u001b[90m │ \u001b[0m        poll_interval: \u001b[96mint\u001b[39;49;00m = POLL_INTERVAL,\u001b[90m\u001b[39;49;00m\n"]
[108.512, "o", "\u001b[90m 348\u001b[0m\u001b[90m │ \u001b[0m        poll_timeout: \u001b[96mint\u001b[39;49;00m = POLL_TIMEOUT,\u001b[90m\u001b[39;49;00m\n"]
[108.567, "o", "\u001b[90m 349\u001b[0m\u001b[90m │ \u001b[0m        cancel_event: Optional[Callable[[], \u001b[96mbool\u001b[39;49;00m]] = \u001b[94mNone\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[108.622, "o", "\u001b[90m 350\u001b[0m\u001b[90m │ \u001b[0m    ) -> \u001b[96mdict\u001b[39;49;00m[\u001b[96mstr\u001b[39;49;00m, Any]:\u001b[90m\u001b[39;49;00m\n"]
[108.677, "o", "\u001b[90m 351\u001b[0m\u001b[90m │ \u001b[0m        \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[108.732, "o", "\u001b[90m 352\u001b[0m\u001b[90m │ \u001b[0m        Realiza polling de askOperation hasta que la operación finalice (state=\u001b[33m'\u001b[39;49;00m\u001b[33mF\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[108.787, "o", "\u001b[90m 353\u001b[0m\u001b[90m │ \u001b[0m        o se alcance el timeout.\u001b[90m\u001b[39;49;00m\n"]
[108.842, "o", "\u001b[90m 354\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[108.897, "o", "\u001b[90m 355\u001b[0m\u001b[90m │ \u001b[0m        Args:\u001b[90m\u001b[39;49;00m\n"]
[108.952, "o", "\u001b[90m 356\u001b[0m\u001b[90m │ \u001b[0m            operation_id: ID de la operación a monitorear.\u001b[90m\u001b[39;49;00m\n"]
[109.007, "o", "\u001b[90m 357\u001b[0m\u001b[90m │ \u001b[0m            poll_interval: Segundos entre cada consulta.\u001b[90m\u001b[39;49;00m\n"]
[109.062, "o", "\u001b[90m 358\u001b[0m\u001b[90m │ \u001b[0m            poll_timeout: Timeout total en segundos.\u001b[90m\u001b[39;49;00m\n"]
[109.117, "o", "\u001b[90m 359\u001b[0m\u001b[90m │ \u001b[0m            cancel_event: Función que retorna \u001b[94mTrue\u001b[39;49;00m si se debe cancelar la espera.\u001b[90m\u001b[39;49;00m\n"]
[109.172, "o", "\u001b[90m 360\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
