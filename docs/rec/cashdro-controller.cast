[74.27, "o", "\u001b[90m┌─ cashdro_api.py · startOperation ─────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[74.27, "o", "\u001b[90m 191\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mstart_operation\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\n"]
[74.325, "o", "\u001b[90m 192\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mself\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[74.38, "o", "\u001b[90m 193\u001b[0m\u001b[90m │ \u001b[0m        op_type: \u001b[96mint\u001b[39;49;00m = \u001b[94m4\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[74.435, "o", "\u001b[90m 194\u001b[0m\u001b[90m │ \u001b[0m        amount: Optional[\u001b[96mfloat\u001b[39;49;00m] = \u001b[94mNone\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[74.49, "o", "\u001b[90m 195\u001b[0m\u001b[90m │ \u001b[0m        posid: \u001b[96mstr\u001b[39;49;00m = POS_ID,\u001b[90m\u001b[39;49;00m\n"]
[74.545, "o", "\u001b[90m 196\u001b[0m\u001b[90m │ \u001b[0m        posuser: \u001b[96mstr\u001b[39;49;00m = POS_USER,\u001b[90m\u001b[39;49;00m\n"]
[74.6, "o", "\u001b[90m 197\u001b[0m\u001b[90m │ \u001b[0m        aliasid: \u001b[96mstr\u001b[39;49;00m = ALIAS_ID,\u001b[90m\u001b[39;49;00m\n"]
[74.655, "o", "\u001b[90m 198\u001b[0m\u001b[90m │ \u001b[0m    ) -> \u001b[96mstr\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[74.71, "o", "\u001b[90m 199\u001b[0m\u001b[90m │ \u001b[0m        \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[74.765, "o", "\u001b[90m 200\u001b[0m\u001b[90m │ \u001b[0m        startOperation \u001b[04m\u001b[91m—\u001b[39;49;00m Inicia una transacción en el CashDro.\u001b[90m\u001b[39;49;00m\n"]
[74.82, "o", "\u001b[90m 201\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[74.875, "o", "\u001b[90m 202\u001b[0m\u001b[90m │ \u001b[0m        Args:\u001b[90m\u001b[39;49;00m\n"]
[74.93, "o", "\u001b[90m 203\u001b[0m\u001b[90m │ \u001b[0m            op_type: Tipo de operación (\u001b[94m4\u001b[39;49;00m = venta/cobro).\u001b[90m\u001b[39;49;00m\n"]
[74.985, "o", "\u001b[90m 204\u001b[0m\u001b[90m │ \u001b[0m            amount: Monto en euros (ej: \u001b[94m18.25\u001b[39;49;00m). Se multiplica por \u001b[94m100\u001b[39;49;00m internamente.\u001b[90m\u001b[39;49;00m\n"]
[75.04, "o", "\u001b[90m 205\u001b[0m\u001b[90m │ \u001b[0m            posid: Identificador \u001b[94mdel\u001b[39;49;00m punto de venta.\u001b[90m\u001b[39;49;00m\n"]
[75.095, "o", "\u001b[90m 206\u001b[0m\u001b[90m │ \u001b[0m            posuser: Usuario \u001b[94mdel\u001b[39;49;00m punto de venta.\u001b[90m\u001b[39;49;00m\n"]
[75.15, "o", "\u001b[90m 207\u001b[0m\u001b[90m │ \u001b[0m            aliasid: Identificador \u001b[94mdel\u001b[39;49;00m equipo.\u001b[90m\u001b[39;49;00m\n"]
[75.205, "o", "\u001b[90m 208\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[75.26, "o", "\u001b[90m 209\u001b[0m\u001b[90m │ \u001b[0m        Returns:\u001b[90m\u001b[39;49;00m\n"]
[75.315, "o", "\u001b[90m 210\u001b[0m\u001b[90m │ \u001b[0m            operationId (string) de la transacción iniciada.\u001b[90m\u001b[39;49;00m\n"]
[75.37, "o", "\u001b[90m 211\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[75.425, "o", "\u001b[90m 212\u001b[0m\u001b[90m │ \u001b[0m        Raises:\u001b[90m\u001b[39;49;00m\n"]
[75.48, "o", "\u001b[90m 213\u001b[0m\u001b[90m │ \u001b[0m            CashDroError: Si el CashDro rechaza la operación.\u001b[90m\u001b[39;49;00m\n"]
[75.535, "o", "\u001b[90m 214\u001b[0m\u001b[90m │ \u001b[0m        \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[75.59, "o", "\u001b[90m 215\u001b[0m\u001b[90m │ \u001b[0m        params: \u001b[96mdict\u001b[39;49;00m[\u001b[96mstr\u001b[39;49;00m, Any] = {\u001b[90m\u001b[39;49;00m\n"]
[75.645, "o", "\u001b[90m 216\u001b[0m\u001b[90m │ \u001b[0m            \u001b[33m\"\u001b[39;49;00m\u001b[33mtype\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[96mstr\u001b[39;49;00m(op_type),\u001b[90m\u001b[39;49;00m\n"]
[75.7, "o", "\u001b[90m 217\u001b[0m\u001b[90m │ \u001b[0m            \u001b[33m\"\u001b[39;49;00m\u001b[33mposid\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: posid,\u001b[90m\u001b[39;49;00m\n"]
[75.755, "o", "\u001b[90m 218\u001b[0m\u001b[90m │ \u001b[0m            \u001b[33m\"\u001b[39;49;00m\u001b[33mposuser\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: posuser,\u001b[90m\u001b[39;49;00m\n"]
[75.81, "o", "\u001b[90m 219\u001b[0m\u001b[90m │ \u001b[0m            \u001b[33m\"\u001b[39;49;00m\u001b[33maliasid\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: aliasid,\u001b[90m\u001b[39;49;00m\n"]
[75.865, "o", "\u001b[90m 220\u001b[0m\u001b[90m │ \u001b[0m        }\u001b[90m\u001b[39;49;00m\n"]
[75.92, "o", "\u001b[90m 221\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[75.975, "o", "\u001b[90m 222\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m amount \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[76.03, "o", "\u001b[90m 223\u001b[0m\u001b[90m │ \u001b[0m            \u001b[90m# El monto se envía multiplicado por 100, sin decimales\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[76.085, "o", "\u001b[90m 224\u001b[0m\u001b[90m │ \u001b[0m            amount_cents = \u001b[96mint\u001b[39;49;00m(\u001b[96mround\u001b[39;49;00m(amount * \u001b[94m100\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\n"]
[76.14, "o", "\u001b[90m 225\u001b[0m\u001b[90m │ \u001b[0m            params[\u001b[33m\"\u001b[39;49;00m\u001b[33mparameters\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] = {\u001b[33m\"\u001b[39;49;00m\u001b[33mamount\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[96mstr\u001b[39;49;00m(amount_cents)}\u001b[90m\u001b[39;49;00m\n"]
[76.195, "o", "\u001b[90m 226\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[76.25, "o", "\u001b[90m 227\u001b[0m\u001b[90m │ \u001b[0m        data = \u001b[96mself\u001b[39;49;00m._call(\u001b[33m\"\u001b[39;49;00m\u001b[33mstartOperation\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, params)\u001b[90m\u001b[39;49;00m\n"]
[76.305, "o", "\u001b[90m 228\u001b[0m\u001b[90m │ \u001b[0m        response = data.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mresponse\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, {})\u001b[90m\u001b[39;49;00m\n"]
[76.36, "o", "\u001b[90m 229\u001b[0m\u001b[90m │ \u001b[0m        operation = response.get(\u001b[33m\"\u001b[39;49;00m\u001b[33moperation\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, {})\u001b[90m\u001b[39;49;00m\n"]
[76.415, "o", "\u001b[90m 230\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[76.47, "o", "\u001b[90m 231\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# La estructura puede variar: a veces viene anidado \"operation\" dentro de \"operation\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[76.525, "o", "\u001b[90m 232\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33moperation\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m operation:\u001b[90m\u001b[39;49;00m\n"]
[76.58, "o", "\u001b[90m 233\u001b[0m\u001b[90m │ \u001b[0m            operation = operation[\u001b[33m\"\u001b[39;49;00m\u001b[33moperation\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\n"]
[76.635, "o", "\u001b[90m 234\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[76.69, "o", "\u001b[90m 235\u001b[0m\u001b[90m │ \u001b[0m        operation_id: \u001b[96mstr\u001b[39;49;00m = operation.get(\u001b[33m\"\u001b[39;49;00m\u001b[33moperationId\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[76.745, "o", "\u001b[90m 236\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m operation_id:\u001b[90m\u001b[39;49;00m\n"]
[76.8, "o", "\u001b[90m 237\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mraise\u001b[39;49;00m CashDroError(-\u001b[94m99\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mNo se recibió operationId en la respuesta\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
