[92.901, "o", "\u001b[90m 263\u001b[0m\u001b[90m │ \u001b[0m        data = \u001b[96mself\u001b[39;49;00m._call(\u001b[33m\"\u001b[39;49;00m\u001b[33maskOperation\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, {\u001b[33m\"\u001b[39;49;00m\u001b[33moperationId\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: operation_id})\u001b[90m\u001b[39;49;00m\n"]
[92.956, "o", "\u001b[90m 264\u001b[0m\u001b[90m │ \u001b[0m        response = data.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mresponse\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, {})\u001b[90m\u001b[39;49;00m\n"]
[93.011, "o", "\u001b[90m 265\u001b[0m\u001b[90m │ \u001b[0m        operation = response.get(\u001b[33m\"\u001b[39;49;00m\u001b[33moperation\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, {})\u001b[90m\u001b[39;49;00m\n"]
