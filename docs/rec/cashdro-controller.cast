[143.512, "o", "\u001b[90m 216\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[143.567, "o", "\u001b[90m 217\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# No tenemos un operationId fijo; pedimos al usuario que ingrese el ID\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[143.622, "o", "\u001b[90m 218\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m  \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m_color(\u001b[33m'\u001b[39;49;00m\u001b[33mIngrese el ID de la operación a anular:\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m,\u001b[90m \u001b[39;49;00mBOLD)\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[143.677, "o", "\u001b[90m 219\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m  \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m_color(\u001b[33m'\u001b[39;49;00m\u001b[33m(Si no conoce el ID, consulte el estado en la opción 3 del menú)\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m,\u001b[90m \u001b[39;49;00m\u001b[04m\u001b[91m…\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[143.732, "o", "\u001b[90m 220\u001b[0m\u001b[90m │ \u001b[0m        op_id = _safe_input(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m  \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m_color(\u001b[33m'\u001b[39;49;00m\u001b[33m➤\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m,\u001b[90m \u001b[39;49;00mYELLOW)\u001b[33m}\u001b[39;49;00m\u001b[33m Operation ID: \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[143.787, "o", "\u001b[90m 221\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[143.842, "o", "\u001b[90m 222\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m op_id:\u001b[90m\u001b[39;49;00m\n"]
[143.897, "o", "\u001b[90m 223\u001b[0m\u001b[90m │ \u001b[0m            mostrar_error(\u001b[96mValueError\u001b[39;49;00m(\u001b[33m\"\u001b[39;49;00m\u001b[33mNo se ingresó un ID de operación\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\n"]
[143.952, "o", "\u001b[90m 224\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[144.007, "o", "\u001b[90m 225\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[144.062, "o", "\u001b[90m 226\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# Verificar estado actual\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[144.117, "o", "\u001b[90m 227\u001b[0m\u001b[90m │ \u001b[0m        mostrar_progreso(\u001b[33m\"\u001b[39;49;00m\u001b[33mConsultando estado de la operación...\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[144.172, "o", "\u001b[90m 228\u001b[0m\u001b[90m │ \u001b[0m        estado = api.ask_operation(op_id)\u001b[90m\u001b[39;49;00m\n"]
[144.227, "o", "\u001b[90m 229\u001b[0m\u001b[90m │ \u001b[0m        state = estado.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mstate\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33munknown\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[144.282, "o", "\u001b[90m 230\u001b[0m\u001b[90m │ \u001b[0m        mostrar_info(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mEstado actual: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mstate\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[144.337, "o", "\u001b[90m 231\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[144.392, "o", "\u001b[90m 232\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m state == \u001b[33m\"\u001b[39;49;00m\u001b[33mF\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[144.447, "o", "\u001b[90m 233\u001b[0m\u001b[90m │ \u001b[0m            mostrar_info(\u001b[33m\"\u001b[39;49;00m\u001b[33mLa operación ya está finalizada. No es necesario anularla.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[144.502, "o", "\u001b[90m 234\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[144.557, "o", "\u001b[90m 235\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[144.612, "o", "\u001b[90m 236\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m confirmar_cancelacion():\u001b[90m\u001b[39;49;00m\n"]
[144.667, "o", "\u001b[90m 237\u001b[0m\u001b[90m │ \u001b[0m            mostrar_progreso(\u001b[33m\"\u001b[39;49;00m\u001b[33mAnulando transacción...\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[144.722, "o", "\u001b[90m 238\u001b[0m\u001b[90m │ \u001b[0m            api.finish_operation(op_id, end_type=\u001b[94m2\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[144.777, "o", "\u001b[90m 239\u001b[0m\u001b[90m │ \u001b[0m            mostrar_paso_ok(\u001b[33m\"\u001b[39;49;00m\u001b[33mTransacción anulada correctamente\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[144.832, "o", "\u001b[90m 240\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94melse\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[144.887, "o", "\u001b[90m 241\u001b[0m\u001b[90m │ \u001b[0m            mostrar_info(\u001b[33m\"\u001b[39;49;00m\u001b[33mAnulación cancelada por el usuario.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
