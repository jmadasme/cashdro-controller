[110.382, "o", "\u001b[90m 382\u001b[0m\u001b[90m │ \u001b[0m            state_data = \u001b[96mself\u001b[39;49;00m.ask_operation(operation_id)\u001b[90m\u001b[39;49;00m\n"]
[110.437, "o", "\u001b[90m 383\u001b[0m\u001b[90m │ \u001b[0m            state = state_data.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mstate\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
