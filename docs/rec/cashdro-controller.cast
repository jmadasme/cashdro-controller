[93.121, "o", "\u001b[90m 267\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# Normalizar estructura anidada\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[93.176, "o", "\u001b[90m 268\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33moperation\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m operation:\u001b[90m\u001b[39;49;00m\n"]
